# ---------------------------------------------------------------------------
# SASA Packaging - Apache rules (website root = Laravel folder, GoDaddy style)
# ---------------------------------------------------------------------------

# Visitors cannot browse folder contents
Options -Indexes

# Hide the server version where the host allows it (ignored otherwise)
ServerSignature Off

# Never print PHP errors on screen for visitors
<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>

# ---- Block hidden files (.env, .git, .htpasswd ...) ------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---- Block backup / config / log / database files --------------------------
<FilesMatch "(?i)\.(env|log|sql|sqlite|bak|old|orig|save|swp|ini|yml|yaml|lock|dist|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ---- PRIVATE folders: the website only needs "public/" and "index.php" ----
    # Without this, anyone could open yoursite.com/storage/logs/laravel.log, /vendor/..., /config/... etc.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L,NC]

    # Project files that must never be downloaded
    RewriteRule ^(artisan|composer\.json|composer\.lock|package\.json|package-lock\.json|server\.php|local-router\.php|tailwind\.config\.js|phpunit\.xml|webpack\.mix\.js)$ - [F,L,NC]

    # Uploaded files are pictures / documents only - never run them as scripts
    RewriteRule ^public/upload/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|exe)$ - [F,L,NC]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
